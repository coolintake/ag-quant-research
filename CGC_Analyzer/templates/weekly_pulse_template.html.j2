{# ══════════════════════════════════════════════════════════════════════
   Canadian Grain Handling Weekly (internal pipeline nickname: Weekly Pulse)
   NOTE: Styles are inline (not in a <style> block) on purpose — Ghost
   strips <style> tags when a post is converted to a newsletter email,
   so inline styles are the only reliable way to keep formatting there
   and on the web post itself. The local HTML file is wrapped in a full
   document (generate_weekly_pulse.DOCUMENT_SHELL) whose <style> block
   carries the 1-page A4 print rules; Ghost receives this fragment only.

   Palette: one dark-navy brand colour (BRAND) for the masthead, section
   divider lines, table column-header rows and footer, all with bold white
   text. Group spanners (Deliveries YTD, West Coast …) sit on light slate.
   Changes are coloured text only (green / red / slate), never cell fills.
   Every table is fixed-layout with Commodity / Indicator at 28%.
   ══════════════════════════════════════════════════════════════════════ #}
{%- set BRAND = '#0A192F' -%}
{%- set INK = '#0F172A' -%}
{%- set MUTED = '#64748B' -%}
{%- set POS = '#15803D' -%}
{%- set NEG = '#B91C1C' -%}
{%- set LINE = '#E2E8F0' -%}
{%- set ZEBRA = '#F8FAFC' -%}
{%- set TABLE = 'width:100%; table-layout:fixed; border-collapse:collapse; font-size:9pt; margin:0;' -%}
{%- set TH = 'padding:4px 6px; background:' ~ BRAND ~ '; color:#FFFFFF; font-weight:700; border:1px solid ' ~ BRAND ~ ';' -%}
{%- set TH2 = 'padding:3px 6px; background:' ~ LINE ~ '; color:' ~ INK ~ '; font-weight:700; border:1px solid ' ~ LINE ~ ';' -%}
{%- set TD = 'padding:4px 6px; border-bottom:1px solid ' ~ LINE ~ ';' -%}
{%- set FIRST = 'padding-left:8px; text-align:left;' -%}
{%- set H2 = 'font-size:8.5pt; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:' ~ BRAND ~ '; border-bottom:2px solid ' ~ BRAND ~ '; padding-bottom:2px; margin:0 0 4px 0;' -%}
{%- set SECTION = 'margin:0 0 10px 0; page-break-inside:avoid; break-inside:avoid;' -%}
{%- set RIBBON_TEXT = 'color:#FFFFFF; font-weight:700;' -%}

{#- Text colour for a signed change: green up, red down, slate for zero / missing. -#}
{%- macro tone(v) -%}
{{ MUTED if (v is none or v == 0) else (NEG if v < 0 else POS) }}
{%- endmacro -%}

{#- Signed % change cell (coloured text only). -#}
{%- macro chg(v, text, bg, star='') -%}
<td style="{{ TD }} background:{{ bg }}; text-align:right; color:{{ tone(v) }};">{{ text }}{% if v is not none %}{{ star }}{% endif %}</td>
{%- endmacro -%}

{#- Plain numeric cell: dash / zero in slate grey. -#}
{%- macro num(v, text, bg) -%}
<td style="{{ TD }} background:{{ bg }}; text-align:right; color:{{ MUTED if (v is none or v == 0) else INK }};">{{ text }}</td>
{%- endmacro -%}

{%- macro chg_inline(v, text) -%}
<span style="font-weight:600; color:{{ tone(v) }};">{{ text }}</span>
{%- endmacro -%}

<div class="cgw-report" style="font-family:Inter, Calibri, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color:{{ INK }}; max-width:720px; margin:0 auto; font-size:9.5pt; line-height:1.25;">

  {# ── MASTHEAD ─────────────────────────────────────────────────────── #}
  <div class="no-break" style="background:{{ BRAND }}; padding:10px 14px; margin:0 0 10px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
      <tr>
        <td align="left" style="padding:0; {{ RIBBON_TEXT }} font-size:7.5pt; letter-spacing:1.5px; text-transform:uppercase;">The Desk</td>
        <td align="right" style="padding:0; {{ RIBBON_TEXT }} font-size:7.5pt; letter-spacing:1.5px; text-transform:uppercase;">Chilmeran Research</td>
      </tr>
    </table>
    <div style="{{ RIBBON_TEXT }} font-size:14pt; letter-spacing:0.2px; margin-top:2px;">
      {{ publication_title }} [{{ week_label }} | {{ crop_year_label }}]
    </div>
  </div>

  {# ── SUMMARY (exactly 3 bullets) ──────────────────────────────────── #}
  <div class="report-section no-break" style="{{ SECTION }}">
    <div class="section-title" style="{{ H2 }}">Summary</div>
    <ul style="margin:0; padding-left:16px; font-size:9.5pt; line-height:1.3; color:{{ INK }};">
      {%- for bullet in summary %}
      {%- set theme, sep, rest = bullet.partition(': ') %}
      <li style="margin:0 0 3px 0;">{% if sep %}<strong>{{ theme }}:</strong> {{ rest }}{% else %}{{ bullet }}{% endif %}</li>
      {%- endfor %}
    </ul>
  </div>

  {# ── MACRO SNAPSHOT ───────────────────────────────────────────────── #}
  {%- set macro_rows = [
    ('Primary deliveries — week', (macro.weekly_deliveries_kt | kt) ~ ' KMT',
      chg_inline(macro.deliveries_wow_pct, macro.deliveries_wow_pct | pct) ~ ' WoW'),
    ('Primary deliveries — YTD', (macro.ytd_deliveries_mmt | mmt) ~ ' MMT',
      chg_inline(macro.deliveries_yoy_pct, macro.deliveries_yoy_pct | pct) ~ ' vs LY &nbsp;|&nbsp; '
      ~ chg_inline(macro.deliveries_vs_5yr_pct, macro.deliveries_vs_5yr_pct | pct) ~ ' vs 5-yr avg'),
    ('Terminal exports — week', (macro.terminal_outflow_total_kt | kt) ~ ' KMT',
      'West Coast (Van + PR) ' ~ (macro.west_coast_kt | kt) ~ ' KMT &nbsp;|&nbsp; East / Interior ' ~ (macro.east_interior_kt | kt) ~ ' KMT'),
    ('Terminal storage in use', (macro.west_coast_util_pct | util) ~ ' / ' ~ (macro.east_interior_util_pct | util),
      'West Coast / East–Interior, share of licensed terminal capacity'),
  ] %}
  <div class="report-section no-break" style="{{ SECTION }}">
    <div class="section-title" style="{{ H2 }}">Macro Snapshot</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="{{ TABLE }}">
      <colgroup><col style="width:28%"><col style="width:16%"><col style="width:56%"></colgroup>
      <thead>
        <tr>
          <th style="{{ TH }} {{ FIRST }}">Indicator</th>
          <th style="{{ TH }} text-align:right;">Value</th>
          <th style="{{ TH }} text-align:left;">Change / Detail</th>
        </tr>
      </thead>
      <tbody>
        {%- for label, value, detail in macro_rows %}
        {%- set bg = ZEBRA if loop.index0 is odd else '#FFFFFF' %}
        <tr>
          <td style="{{ TD }} {{ FIRST }} background:{{ bg }};">{{ label }}</td>
          <td style="{{ TD }} background:{{ bg }}; text-align:right; font-weight:700;">{{ value }}</td>
          <td style="{{ TD }} background:{{ bg }}; text-align:left;">{{ detail }}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </div>

  {# ── COMMODITY FLOW & YTD ─────────────────────────────────────────── #}
  <div class="report-section no-break" style="{{ SECTION }}">
    <div class="section-title" style="{{ H2 }}">Commodity Flow &amp; YTD</div>
    {# Table cells are strictly numerical -- every unit (KMT, MMT, % vs LY)
       lives in the header rows, not in the data cells below. #}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="{{ TABLE }}">
      <colgroup><col style="width:28%">{% for _ in range(8) %}<col style="width:9%">{% endfor %}</colgroup>
      <thead>
        <tr>
          <th colspan="3" style="{{ TH2 }}"></th>
          <th colspan="2" style="{{ TH2 }} text-align:center;">Deliveries YTD</th>
          <th colspan="2" style="{{ TH2 }} text-align:center;">Exports YTD</th>
          <th colspan="2" style="{{ TH2 }} text-align:center;">Terminal Stocks</th>
        </tr>
        <tr>
          <th style="{{ TH }} {{ FIRST }}">Commodity</th>
          <th style="{{ TH }} text-align:right;">Deliv. KMT wk</th>
          <th style="{{ TH }} text-align:right;">Exp. KMT wk</th>
          <th style="{{ TH }} text-align:right;">MMT</th>
          <th style="{{ TH }} text-align:right;">% vs LY</th>
          <th style="{{ TH }} text-align:right;">MMT</th>
          <th style="{{ TH }} text-align:right;">% vs LY</th>
          <th style="{{ TH }} text-align:right;">KMT</th>
          <th style="{{ TH }} text-align:right;">% vs LY</th>
        </tr>
      </thead>
      <tbody>
        {%- for c in commodities %}
        {%- set bg = ZEBRA if loop.index0 is odd else '#FFFFFF' %}
        <tr>
          <td style="{{ TD }} {{ FIRST }} background:{{ bg }}; font-weight:600;">{{ c.display_name }}</td>
          {{ num(c.weekly_deliveries_kt, c.weekly_deliveries_kt | kt, bg) }}
          {{ num(c.weekly_exports_kt, c.weekly_exports_kt | kt, bg) }}
          {{ num(c.ytd_deliveries_mmt, c.ytd_deliveries_mmt | mmt, bg) }}
          {{ chg(c.deliveries_yoy_pct, c.deliveries_yoy_pct | pctnum, bg) }}
          {{ num(c.ytd_exports_mmt, c.ytd_exports_mmt | mmt, bg) }}
          {{ chg(c.exports_yoy_pct, c.exports_yoy_pct | pctnum, bg, '*' if is_early_season else '') }}
          {{ num(c.stocks_kt, c.stocks_kt | kt, bg) }}
          {{ chg(c.stocks_yoy_pct, c.stocks_yoy_pct | pctnum, bg) }}
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </div>

  {# ── YTD EXPORTS BY CORRIDOR ──────────────────────────────────────── #}
  <div class="report-section no-break" style="{{ SECTION }}">
    <div class="section-title" style="{{ H2 }}">YTD Exports by Corridor</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="{{ TABLE }}">
      <colgroup><col style="width:28%">{% for _ in range(4) %}<col style="width:18%">{% endfor %}</colgroup>
      <thead>
        <tr>
          <th style="{{ TH2 }}"></th>
          <th colspan="2" style="{{ TH2 }} text-align:center;">West Coast (Van + PR)</th>
          <th colspan="2" style="{{ TH2 }} text-align:center;">East / Interior</th>
        </tr>
        <tr>
          <th style="{{ TH }} {{ FIRST }}">Commodity</th>
          <th style="{{ TH }} text-align:right;">KMT</th>
          <th style="{{ TH }} text-align:right;">% vs LY</th>
          <th style="{{ TH }} text-align:right;">KMT</th>
          <th style="{{ TH }} text-align:right;">% vs LY</th>
        </tr>
      </thead>
      <tbody>
        {%- for c in commodities %}
        {%- set bg = ZEBRA if loop.index0 is odd else '#FFFFFF' %}
        <tr>
          <td style="{{ TD }} {{ FIRST }} background:{{ bg }}; font-weight:600;">{{ c.display_name }}</td>
          {{ num(c.west_export_ytd_kt, c.west_export_ytd_kt | kt, bg) }}
          {{ chg(c.west_export_yoy_pct, c.west_export_yoy_pct | pctnum, bg, '*' if is_early_season else '') }}
          {{ num(c.east_export_ytd_kt, c.east_export_ytd_kt | kt, bg) }}
          {{ chg(c.east_export_yoy_pct, c.east_export_yoy_pct | pctnum, bg, '*' if is_early_season else '') }}
        </tr>
        {%- endfor %}
      </tbody>
    </table>
    <p style="font-size:7.5pt; color:{{ MUTED }}; font-style:italic; margin:8px 0 0 0;">
      Most primary deliveries are Western; this table shows where grain actually leaves the country.
      {%- if is_early_season %} * Early crop-year percentages (weeks 1–10) can be volatile due to low prior-year bases.{% endif %}
    </p>
  </div>

  {# ── FOOTER ────────────────────────────────────────────────────────── #}
  <div class="no-break" style="background:{{ BRAND }}; padding:6px 14px; text-align:center;">
    <div style="color:#FFFFFF; font-size:7.5pt;">
      Source: Canadian Grain Commission, Grain Statistics Weekly &nbsp;|&nbsp; Chilmeran Research | Grain Market Intelligence |
      <a href="https://{{ footer_url }}" style="color:#FFFFFF; font-weight:700; text-decoration:none;">{{ footer_url }}</a>
    </div>
  </div>

</div>
