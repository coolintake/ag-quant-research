# Copy to `.env` in CGC_Analyzer/ (requires `pip install python-dotenv`),
# or set these as real environment variables instead.

# --- Data / capacity paths (optional overrides) ---
CGC_DATA_DIR=./data_cache
CGC_CAPACITY_FILE=./CGC_Capacity        # no extension — .xlsb/.xlsx/.xls auto-detected

# --- Ghost Admin API ---
GHOST_API_URL=https://yoursite.ghost.io
GHOST_ADMIN_API_KEY=<id>:<secret>       # from Ghost Admin -> Integrations -> Custom Integration

# --- Optional LLM commentary (Anthropic) ---
WEEKLY_PULSE_USE_LLM=0                  # set to 1 to enable
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
