    "table": "32-10-0359",
    "title": "Estimated areas, yield, production, average farm price and total farm value of principal field crops",
    "search_root": "../Workspace_CanadaSD/Data_Inputs",
    "file": "32100359.csv",
    "path": "../Workspace_CanadaSD/Data_Inputs/Planting_32100359-eng/32100359.csv",
    "series": "Seeded area (acres)",
    "window_years": 3,
    "provinces": {"MB": "Manitoba", "SK": "Saskatchewan", "AB": "Alberta"},
    "crops": {
      "wheat_spring": "Wheat, Canada Western Red Spring (CWRS)",
      "wheat_cps": "Wheat, Canada Prairie Spring Red (CPSR) and Canada Prairie Spring White (CPSW)",
      "durum": "Wheat, durum",
      "canola": "Canola (rapeseed)",
      "barley_feed": "Barley",
      "barley_malt": "Barley",
      "oats": "Oats",
      "peas_yellow": "Peas, dry",
      "lentils_red": "Lentils",
      "soybeans": "Soybeans",
      "corn": "Corn for grain",
      "flax": "Flaxseed",
      "rye_hybrid_fall": "Rye, fall seeded in previous fall"
    }
  },

