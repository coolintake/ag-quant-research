  "outputs": {
    "workbook_tabs": ["RPA_Prairie", "Control_Panel", "RPA_Summary_MB", "RPA_Summary_SK", "RPA_Summary_AB", "Agronomic_Rates",
                      "Historical_Ratios"],
    "historical_ratios": {
      "rule_id": "HIST-RATIOS",
      "provinces": ["MB", "SK", "AB"],
      "bases": [
        {"base": "wheat_spring", "numerators": ["canola"]},
        {"base": "durum", "numerators": ["wheat_spring", "lentils_red"]},
        {"base": "lentils_red", "numerators": ["peas_yellow"]},
        {"base": "canola", "numerators": ["soybeans"]}
      ]
    }
  }
}
